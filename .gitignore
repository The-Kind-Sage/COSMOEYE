# --- Ignore Heavy Datasets (Crucial!) ---
data/
*.h5
*.npy
*.zip
*.tar.gz

# Sample tiles shipped with the repo for the out-of-the-box demo
!sample_tiles/
!sample_tiles/*.h5

# --- Ignore Local Python Virtual Environments ---
cosmoeye_env/
env/
venv/
ENV/
bin/
lib/
include/

# --- Ignore Python Cache and System Files ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# --- Ignore Per-Run Training Artifacts ---
training_runs/
train_history.csv

# --- Ignore Operating System Artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- Ignore Image Outputs ---
*.png
