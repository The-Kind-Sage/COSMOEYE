# --- Ignore Heavy Datasets (Crucial!) ---
data/
*.h5
*.npy
*.zip
*.tar.gz

# --- Ignore Local Python Virtual Environments ---
cosmoeye_env/
env/
venv/
ENV/
bin/
lib/
include/

# --- Ignore Python Cache and System Files ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# --- Ignore Heavy Model Weights ---
local_models/t5_weights/*.safetensors
*.pth

# --- Ignore Per-Run Training Artifacts ---
training_runs/
train_history.csv
landslide_best_threshold.json

# --- Ignore Operating System Artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- Ignore Image Outputs ---
*.png
