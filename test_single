import gzip
import os
import h5py
import numpy as np
from netCDF4 import Dataset

# --- TARGET DOCK PATH TO REVERSED DICTIONARY KEY STRUCTURAL TILES ---
test_nc_path = "D:/COSMOEYE/datasets/s2/s2_part01/chimanimani_s2_101.nc"

print(f"Step 1: Checking physical file path...")
if not os.path.exists(test_nc_path):
    print(f"❌ Error: Could not find the file at {test_nc_path}")
    print("Please verify the subfolder name and spelling.")
    exit()

print(f"✅ File found. Size: {os.path.getsize(test_nc_path) / 1024:.2f} KB")
print("-" * 50)

try:
    print("Step 2: Attempting to read NetCDF data layers...")
    # Attempt to open as a compressed gzip stream first
    try:
        with gzip.open(test_nc_path, "rb") as gz_file:
            nc_bytes = gz_file.read()
        src = Dataset("memory_test", memory=nc_bytes)
        print("💡 File format identified: Compressed Gzip NetCDF (.nc.gz)")
    except Exception:
        # Fallback to standard uncompressed NetCDF reader
        src = Dataset(test_nc_path, "r")
        print("💡 File format identified: Uncompressed NetCDF (.nc)")

    # 3. Extract variables natively from explicit individual key headers [paulhoehn/Sen12Landslides]
    # Each band array has a shape of (time: 15, x: 128, y: 128)
    # Index -1 isolates the definitive post-disaster temporal frame slice
    red_series = src.variables["B04"][-1, :, :]
    nir_series = src.variables["B08"][-1, :, :]
    post_event_mask = src.variables["MASK"][-1, :, :]
    src.close()

    print(f"✅ Raw Data Matrix loaded successfully.")
    print(f"   Red Channel (B04) Shape : {red_series.shape}")
    print(f"   NIR Channel (B08) Shape : {red_series.shape}")
    print(f"   Landslide Mask Shape    : {post_event_mask.shape}")
    print("-" * 50)

    print("Step 3: Casting matrices to floating point variables...")
    red_channel = red_series.astype(np.float32)
    nir_channel = nir_series.astype(np.float32)

    print("Step 4: Building standard 14-channel Option A matrix...")
    # Instantiate zero matrix tracker blocks (128, 128, 14)
    standardized_14_bands = np.zeros((128, 128, 14), dtype=np.float32)
    standardized_14_bands[:, :, 3] = red_channel  # Lock Red to index channel slot 3
    standardized_14_bands[:, :, 7] = nir_channel  # Lock NIR to index channel slot 7

    # Calculate manual NDVI vegetation index layer from scratch
    numerator = nir_channel - red_channel
    denominator = nir_channel + red_channel + 1e-8
    computed_ndvi = numerator / denominator
    
    # Place calculated index maps directly into the 14th band channel slot
    standardized_14_bands[:, :, 13] = computed_ndvi

    print(f"✅ 14-Channel shape built: {standardized_14_bands.shape}")
    print("-" * 50)

    print("Step 5: Exporting to standard .h5 container...")
    os.makedirs("./datasets/TrainData/img/", exist_ok=True)
    os.makedirs("./datasets/TrainData/mask/", exist_ok=True)

    with h5py.File("./datasets/TrainData/img/single_test.h5", "w") as f_img:
        f_img.create_dataset("img", data=standardized_14_bands)

    with h5py.File("./datasets/TrainData/mask/single_test.h5", "w") as f_msk:
        f_msk.create_dataset("mask", data=post_event_mask.astype(np.uint8))

    print("\n================ TEST SUCCESSFUL ================")
    print("🎉 One file converted perfectly from scratch!")
    print("Output verified at: ./datasets/TrainData/img/single_test.h5")
    print("=================================================\n")

except Exception as e:
    print(f"\n❌ Pipeline Crash! Detailed Error Stack: {str(e)}")
